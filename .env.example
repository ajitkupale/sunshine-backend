# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=sunshine-hospital-media
# Optional: CloudFront CDN URL (leave empty to use direct S3 URL)
AWS_CLOUDFRONT_URL=

# Server
PORT=4000
NODE_ENV=development

# CORS - comma separated list of allowed origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Next.js ISR Revalidation Secret (must match REVALIDATE_SECRET in Next.js .env)
REVALIDATE_SECRET=your-revalidation-webhook-secret
