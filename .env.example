# MongoDB
MONGODB_URI=mongodb+srv://harshhujare5124_db_user:bWpi08RyJL5Uf068@cluster0.nsdtbtp.mongodb.net

# JWT
JWT_SECRET=your-super-long-random-secret-at-least-64-characters-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-token-secret-different-from-access-secret
